{
  "$schema": "../plugin.schema.json",
  "id": "nucleardawn",
  "name": "NuclearDawn Dedicated Server",
  "description": "WindowsGSM plugin for supporting NuclearDawn Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.NuclearDawn",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.NuclearDawn)",
      "url": "https://github.com/Raziel7893/WindowsGSM.NuclearDawn",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/111710/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "111710"
  },
  "run": {
    "exe": "ndsrv.exe",
    "args": [
      "-console",
      [
        "-game",
        "nucleardawn"
      ],
      [
        "-ip",
        "{ip}"
      ],
      [
        "-port",
        "{port}"
      ],
      [
        "+sv_setsteamaccount",
        "{gslt}"
      ],
      "{param}",
      [
        "+map",
        "{map}"
      ]
    ],
    "stdin": true
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27015",
    "maxPlayers": "16",
    "map": "downtown",
    "additional": "-nocrashdialog -autoupdate",
    "portIncrement": 1
  },
  "query": "a2s",
  "gslt": true
}
