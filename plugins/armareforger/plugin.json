{
  "$schema": "../plugin.schema.json",
  "id": "armareforger",
  "name": "ArmaReforger Dedicated Server",
  "description": "WindowsGSM plugin for supporting ArmaReforger Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.ArmaReforger",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.ArmaReforger)",
      "url": "https://github.com/Raziel7893/WindowsGSM.ArmaReforger",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/1874900/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "1874900"
  },
  "run": {
    "exe": "ArmaReforgerServer.exe",
    "args": [
      [
        "-bindIP",
        "{ip}"
      ],
      [
        "-a2sPort",
        "{queryPort}"
      ],
      [
        "-bindPort",
        "{port}"
      ],
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "2302",
    "queryPort": "7777",
    "maxPlayers": "16",
    "map": "notUsed",
    "additional": "-profile \".\\Saved\" -maxFPS 60 -config \".\\Configs\\server.json\"",
    "portIncrement": 1
  },
  "query": "a2s"
}
