{
  "$schema": "../plugin.schema.json",
  "id": "hytale",
  "name": "Hytale Dedicated Server",
  "description": "WindowsGSM plugin for supporting Hytale Dedicated Server",
  "author": "raziel7893",
  "version": "1.1.1",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.Hytale",
  "tags": [
    "windowsgsm-import",
    "needs-work"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.Hytale)",
      "url": "https://github.com/Raziel7893/WindowsGSM.Hytale",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "manual"
  },
  "run": {
    "exe": "Server/HytaleServer.jar",
    "args": [
      "{gslt}",
      "-jar",
      "--assets",
      "--bind",
      "{ip}:{port}",
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "5520",
    "queryPort": "5520",
    "maxPlayers": "16",
    "map": "Assets.zip",
    "portIncrement": 1
  },
  "query": "a2s",
  "gslt": true
}
