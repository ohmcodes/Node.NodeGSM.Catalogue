{
  "$schema": "../plugin.schema.json",
  "id": "outworlder",
  "name": "Outworld Dedicated Server",
  "description": "WindowsGSM plugin for supporting Outworlder Dedicated Server",
  "author": "Tempus Thales",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/tempusthales/WindowsGSM.outworlder",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34c9eb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (tempusthales/WindowsGSM.outworlder)",
      "url": "https://github.com/tempusthales/WindowsGSM.outworlder",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/1363900/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "1363900"
  },
  "run": {
    "exe": "path/to/gameserverexecutable/goes/here",
    "args": [
      "-log",
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "9999",
    "queryPort": "9999",
    "maxPlayers": "60",
    "map": "Default Map Name",
    "portIncrement": 1
  }
}
