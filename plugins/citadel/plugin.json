{
  "$schema": "../plugin.schema.json",
  "id": "citadel",
  "name": "Citadel Dedicated Server",
  "description": "WindowsGSM plugin for supporting Citadel Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/Windowsgsm.Citadel",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/Windowsgsm.Citadel)",
      "url": "https://github.com/Raziel7893/Windowsgsm.Citadel",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/489650/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "489650"
  },
  "run": {
    "exe": "Citadel/Binaries/Win64/CitadelServer-Win64-Shipping.exe",
    "args": [
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "40",
    "map": "default",
    "additional": "-nosteamclient -server -log",
    "portIncrement": 1
  },
  "query": "a2s"
}
