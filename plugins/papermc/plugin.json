{
  "$schema": "../plugin.schema.json",
  "id": "papermc",
  "name": "Minecraft: Paper Server",
  "description": "🧩 WindowsGSM plugin for supporting Minecraft: Paper Server",
  "author": "BattlefieldDuck",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/BattlefieldDuck/WindowsGSM.PaperMC",
  "tags": [
    "windowsgsm-import",
    "needs-work"
  ],
  "color": "#ffffff",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (BattlefieldDuck/WindowsGSM.PaperMC)",
      "url": "https://github.com/BattlefieldDuck/WindowsGSM.PaperMC",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "manual"
  },
  "run": {
    "exe": "paper.jar",
    "command": "java",
    "args": [
      "{param}",
      "-jar",
      "paper.jar",
      "nogui"
    ],
    "stdin": true,
    "stopCommand": "stop"
  },
  "defaults": {
    "port": "25565",
    "queryPort": "25565",
    "maxPlayers": "20",
    "map": "world",
    "portIncrement": 1
  },
  "query": "ut3"
}
