{
  "$schema": "../plugin.schema.json",
  "id": "vein",
  "name": "Vein Dedicated Server",
  "description": "WindowsGSM plugin for supporting Vein Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.2",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.Vein",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.Vein)",
      "url": "https://github.com/Raziel7893/WindowsGSM.Vein",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/2131400/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "2131400"
  },
  "run": {
    "exe": "Vein/Binaries/Win64/VeinServer-Win64-Test.exe",
    "args": [
      "-Port={port}",
      "-QueryPort={queryPort}",
      "-multihome={ip}",
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "16",
    "map": "default",
    "additional": "-log",
    "portIncrement": 1
  },
  "query": "a2s"
}
