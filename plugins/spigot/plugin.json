{
  "$schema": "../plugin.schema.json",
  "id": "spigot",
  "name": "Minecraft: Spigot Server",
  "description": "WindowsGSM plugin that provides support for Minecraft: Spigot Server",
  "author": "1stian",
  "version": "1.2.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/1stian/WindowsGSM.Spigot",
  "tags": [
    "windowsgsm-import",
    "needs-work"
  ],
  "color": "#fc7f03",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (1stian/WindowsGSM.Spigot)",
      "url": "https://github.com/1stian/WindowsGSM.Spigot",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "manual"
  },
  "run": {
    "exe": "spigot.jar",
    "command": "java",
    "args": [
      "{param}",
      "-jar",
      "spigot.jar",
      "nogui"
    ],
    "stdin": true,
    "stopCommand": "stop"
  },
  "defaults": {
    "port": "25565",
    "queryPort": "25565",
    "maxPlayers": "20",
    "map": "world",
    "portIncrement": 1
  },
  "query": "ut3"
}
