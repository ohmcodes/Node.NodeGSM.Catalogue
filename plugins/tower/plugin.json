{
  "$schema": "../plugin.schema.json",
  "id": "tower",
  "name": "Tower Unite Dedicated Server",
  "description": "Dedicated server support for Tower Unite. Install, run and monitor it from NodeGSM.",
  "author": "NodeGSM community",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://steamdb.info/app/439660/info/",
  "tags": [
    "steam-import",
    "steamcmd",
    "unreal",
    "needs-work"
  ],
  "docs": [
    {
      "title": "SteamDB: dedicated server app info",
      "url": "https://steamdb.info/app/439660/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    },
    {
      "title": "Steam store page",
      "url": "https://store.steampowered.com/app/439660/",
      "type": "official"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "439660"
  },
  "run": {
    "exe": "Tower/Binaries/Win64/TowerServer-Win64-Shipping.exe",
    "args": [
      "-log",
      "-Port={port}",
      "{param}"
    ]
  },
  "defaults": {
    "port": "7777",
    "maxPlayers": "30"
  },
  "query": "a2s"
}
