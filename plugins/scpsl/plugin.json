{
  "$schema": "../plugin.schema.json",
  "id": "scpsl",
  "name": "SCP: Secret Laboratory Dedicated Server",
  "description": "WindowsGSM plugin for SCP: Secret Laboratory Dedicated Server (MeFriendos build)",
  "author": "MeFriendos",
