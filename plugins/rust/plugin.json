{
  "$schema": "../plugin.schema.json",
  "id": "rust",
  "name": "Rust Dedicated Server",
  "description": "Dedicated server support for Rust. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "platforms": ["windows", "linux"],
  "url": "https://steamdb.info/app/258550/info/",
  "tags": ["unity", "steamcmd"],
  "docs": [
    { "title": "Creating a Rust server", "url": "https://wiki.facepunch.com/rust/Creating-a-server", "type": "official", "description": "Facepunch wiki" },
    { "title": "SteamCMD reference", "url": "https://developer.valvesoftware.com/wiki/SteamCMD", "type": "official", "description": "Valve Developer Community" },
    { "title": "SteamDB: dedicated server app info", "url": "https://steamdb.info/app/258550/info/", "type": "unofficial", "description": "App id, depots and build history" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "258550"
  },
  "run": {
    "exe": "RustDedicated.exe",
    "linux": { "exe": "RustDedicated", "env": { "LD_LIBRARY_PATH": "{serverFiles}/RustDedicated_Data/Plugins/x86_64" } },
    "args": [
      "-nographics",
      "-batchmode",
      "-silent-crashes",
      ["+server.hostname", "{name}"],
      ["+server.ip", "{ip}"],
      ["+server.port", "{port}"],
      ["+server.queryport", "{queryPort}"],
      ["+server.level", "{map}"],
      ["+server.maxplayers", "{maxPlayers}"],
      "{param}"
    ]
  },
  "defaults": {
    "port": "28015",
    "queryPort": "28016",
    "map": "Procedural Map",
    "maxPlayers": "50",
    "additional": ""
  },
  "query": "a2s",
  "metrics": [
    {
      "id": "fps",
      "name": "Server FPS",
      "unit": "fps",
      "kind": "tick",
      "source": "console",
      "command": "fps",
      "pattern": "([0-9]+(?:\\.[0-9]+)?)\\s*FPS",
      "intervalSec": 15,
      "tickTarget": 30,
      "warnBelow": 25,
      "badBelow": 15,
      "description": "Server frame rate from the 'fps' console command (the console must be reachable: do not start with -nographics-only setups that hide stdin)."
    }
  ],
  "cluster": {
    "protectedConfigKeys": ["server.port", "server.identity", "rcon.*"],
    "preserve": ["server", "oxide/data"],
    "clearFolders": [
      { "path": "oxide/logs", "pattern": "*.txt", "olderThanDays": 14 }
    ]
  },
  "backup": {
    "presets": [
      {
        "id": "server-data",
        "name": "Server data (map, saves, player data, cfg)",
        "paths": [
          "server"
        ]
      },
      {
        "id": "oxide",
        "name": "Oxide / uMod plugins and data",
        "paths": [
          "oxide"
        ]
      }
    ],
    "exclude": [
      "*.tmp"
    ]
  }
}
