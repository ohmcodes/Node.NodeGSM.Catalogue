{
  "$schema": "../plugin.schema.json",
  "id": "deadpoly",
  "name": "DeadPoly Dedicated Server",
  "description": "WindowsGSM plugin for supporting DeadPoly Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.DeadPoly",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.DeadPoly)",
      "url": "https://github.com/Raziel7893/WindowsGSM.DeadPoly",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/2208380/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "2208380"
  },
  "run": {
    "exe": "DeadPoly/Binaries/Win64/DeadPolyServer.exe",
    "args": [
      "?ServerName={name}?Port={port}?QueryPort={queryPort}?MaxPlayers={maxPlayers}?PlayerSlots={maxPlayers}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7783",
    "queryPort": "7784",
    "maxPlayers": "16",
    "map": "Dedicated",
    "additional": "-batchmode -nographics -log -nosteam",
    "portIncrement": 1
  },
  "query": "a2s"
}
