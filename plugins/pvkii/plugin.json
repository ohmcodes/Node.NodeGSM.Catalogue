{
  "$schema": "../plugin.schema.json",
  "id": "pvkii",
  "name": "Pirates, Vikings and Knights II Dedicated Server",
  "description": "Dedicated server support for Pirates, Vikings and Knights II. Install, run and monitor it from NodeGSM.",
  "author": "NodeGSM community",
  "version": "1.0.0",
  "platforms": [
    "windows",
    "linux"
  ],
  "url": "https://steamdb.info/app/17575/info/",
  "tags": [
    "steam-import",
    "steamcmd",
    "source",
    "needs-work"
  ],
  "docs": [
    {
      "title": "SteamDB: dedicated server app info",
      "url": "https://steamdb.info/app/17575/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    },
    {
      "title": "Steam store page",
      "url": "https://store.steampowered.com/app/17575/",
      "type": "official"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "17575"
  },
  "run": {
    "exe": "srcds.exe",
    "args": [
      "-steam",
      "-console",
      [
        "-game",
        "pvkii"
      ],
      [
        "-ip",
        "{ip}"
      ],
      [
        "-port",
        "{port}"
      ],
      [
        "-maxplayers",
        "{maxPlayers}"
      ],
      "{param}",
      [
        "+map",
        "{map}"
      ]
    ],
    "linux": {
      "exe": "srcds_run"
    }
  },
  "defaults": {
    "port": "27015",
    "map": "ctf_harbor",
    "maxPlayers": "24"
  },
  "query": "a2s"
}
