{
  "$schema": "../plugin.schema.json",
  "id": "echoesofelysium",
  "name": "EchoesofElysium Dedicated Server",
  "description": "WindowsGSM plugin for supporting EchoesofElysium Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/Windowsgsm.EchoesofElysium",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/Windowsgsm.EchoesofElysium)",
      "url": "https://github.com/Raziel7893/Windowsgsm.EchoesofElysium",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/2915100/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "2915100"
  },
  "run": {
    "exe": "ElysiumServer.exe",
    "args": [
      "{param}",
      "--config",
      "./config.json"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "27017",
    "queryPort": "27017",
    "maxPlayers": "16",
    "map": "default",
    "portIncrement": 2
  },
  "query": "a2s"
}
