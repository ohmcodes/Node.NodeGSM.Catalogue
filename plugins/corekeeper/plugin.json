{
  "$schema": "../plugin.schema.json",
  "id": "corekeeper",
  "name": "CoreKeeper Dedicated Server",
  "description": "WindowsGSM plugin for supporting CoreKeeper Dedicated Server",
  "author": "Geekbee",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/GeekbeeGER/WindowsGSM.CoreKeeper",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34c9ec",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (GeekbeeGER/WindowsGSM.CoreKeeper)",
      "url": "https://github.com/GeekbeeGER/WindowsGSM.CoreKeeper",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/1963720/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "1963720"
