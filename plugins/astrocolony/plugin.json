{
  "$schema": "../plugin.schema.json",
  "id": "astrocolony",
  "name": "AstroColony Dedicated Server",
  "description": "WindowsGSM plugin for supporting AstroColony Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.AstroColony",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.AstroColony)",
      "url": "https://github.com/Raziel7893/WindowsGSM.AstroColony",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/2662210/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "2662210"
  },
  "run": {
    "exe": "AstroColony/Binaries/Win64/AstroColonyServer.exe",
    "args": [
      "-SteamServerName={name}",
      "-port={port}",
      "-QueryPort={queryPort}",
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "32",
    "map": "Dedicated",
    "additional": "-log",
    "portIncrement": 1
  },
  "query": "a2s"
}
