{
  "$schema": "../plugin.schema.json",
  "id": "gta5",
  "name": "Grand Theft Auto V Dedicated Server (FiveM)",
  "description": "Dedicated server support for Grand Theft Auto V (FiveM). Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "",
  "tags": ["fivem", "download"],
  "docs": [
    { "title": "FiveM: setting up a server", "url": "https://docs.fivem.net/docs/server-manual/setting-up-a-server/", "type": "official", "description": "Official Cfx.re documentation" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "steps": [
      {
        "type": "script"
      }
    ]
  },
  "run": {
    "exe": "server/FXServer.exe",
    "workingDir": "server",
    "args": ["+set", "citizen_dir", "{serverFiles}/server/citizen", "{param}"]
  },
  "defaults": {
    "port": "30120",
    "queryPort": "30120",
    "map": "fivem-map-skater",
    "maxPlayers": "32",
    "additional": "+exec server.cfg"
  },
  "query": "fivem",
  "configs": [
    {
      "id": "server-cfg",
      "name": "server.cfg",
      "path": "server/server.cfg",
      "format": "cfg",
      "description": "License key, endpoints, resources"
    }
  ]
}
