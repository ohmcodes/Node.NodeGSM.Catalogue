{
  "$schema": "../plugin.schema.json",
  "id": "rem",
  "name": "REM Dedicated Server",
  "description": "WindowsGSM plugin for supporting REM Dedicated Server",
  "author": "raziel7893",
  "version": "1.1.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.REM",
  "tags": [
    "windowsgsm-import",
    "needs-work"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.REM)",
      "url": "https://github.com/Raziel7893/WindowsGSM.REM",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "manual"
  },
  "run": {
    "exe": "RemSurvival/Binaries/Win64/RemSurvivalServer-Win64-Test.exe",
    "args": [
      "-MultiHome={ip}",
      "-Port={port}",
      "-QueryPort={queryPort}",
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "16",
    "map": "Dedicated",
    "additional": "+set exec_maxThreads 1 +set net_serverPortAuth 8766 +exec autoexec.cfg",
    "portIncrement": 1
  },
  "query": "a2s"
}
