{
  "$schema": "../plugin.schema.json",
  "id": "necesse",
  "name": "Necesse Dedicated Server",
  "description": "WindowsGSM plugin for supporting Necesse Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.1",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.Necesse",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.Necesse)",
      "url": "https://github.com/Raziel7893/WindowsGSM.Necesse",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/1169370/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "1169370"
  },
  "run": {
    "exe": "jre/bin/java.exe",
    "args": [
      "-jar",
      "Server.jar",
      [
        "-world",
        "{map}"
      ],
      [
        "-port",
        "{port}"
      ],
      [
        "-slots",
        "{maxPlayers}"
      ],
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "14159",
    "queryPort": "27015",
    "maxPlayers": "32",
    "map": "YourWorldName",
    "additional": "-nogui -datadir .\\data",
    "portIncrement": 1
  },
  "query": "a2s"
}
