{
  "$schema": "../plugin.schema.json",
  "id": "automobilista2",
  "name": "Automobilista2 Dedicated Server",
  "description": "WindowsGSM plugin for supporting Automobilista2 Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.Automobilista2",
  "tags": [
    "windowsgsm-import",
    "needs-work",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.Automobilista2)",
      "url": "https://github.com/Raziel7893/WindowsGSM.Automobilista2",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/1338040/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "1338040"
  },
  "run": {
    "exe": "DedicatedServerCmd.exe",
    "stdin": true
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27016",
    "maxPlayers": "16",
    "map": "Dedicated",
    "additional": "-LOCALLOGTIMES -log",
    "portIncrement": 1
  },
  "query": "a2s"
}
