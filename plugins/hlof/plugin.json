{
  "$schema": "../plugin.schema.json",
  "id": "hlof",
  "name": "Half-Life: Opposing Force Dedicated Server",
  "description": "Dedicated server support for Half-Life: Opposing Force. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/90/info/",
  "tags": ["goldsource", "steamcmd"],
  "docs": [
    { "title": "HLDS (GoldSource dedicated server)", "url": "https://developer.valvesoftware.com/wiki/HLDS", "type": "official", "description": "Valve Developer Community" },
    { "title": "SteamCMD reference", "url": "https://developer.valvesoftware.com/wiki/SteamCMD", "type": "official", "description": "Valve Developer Community" },
    { "title": "SteamDB: dedicated server app info", "url": "https://steamdb.info/app/90/info/", "type": "unofficial", "description": "App id, depots and build history" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "steps": [
      {
        "type": "steamcmd",
        "appId": "90",
        "mod": "gearbox",
        "repeat": 5
      },
      {
        "type": "write",
        "path": "steam_appid.txt",
        "content": "50"
      }
    ]
  },
  "run": {
    "exe": "hlds.exe",
    "stdin": false,
    "args": [
      "-console",
      ["-game", "gearbox"],
      ["-ip", "{ip}"],
      ["-port", "{port}"],
      ["-maxplayers", "{maxPlayers}"],
      ["+sv_setsteamaccount", "{gslt}"],
      "{param}",
      ["+map", "{map}"]
    ]
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27015",
    "map": "op4_bootcamp",
    "maxPlayers": "24",
    "additional": ""
  },
  "query": "a2s",
  "configs": [
    {
      "id": "server-cfg",
      "name": "server.cfg",
      "path": "gearbox/server.cfg",
      "format": "cfg",
      "description": "Main server config (hostname, rcon_password, ...)"
    }
  ],
  "logs": [
    {
      "id": "server-logs",
      "name": "Server logs",
      "path": "gearbox/logs/*.log"
    }
  ]
}
