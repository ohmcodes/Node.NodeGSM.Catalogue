{
  "$schema": "../plugin.schema.json",
  "id": "alienvspredator",
  "name": "Alien vs Predator Dedicated Server",
  "description": "WindowsGSM plugin for supporting Alien vs Predator Dedicated Server",
  "author": "ohmcodes",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
