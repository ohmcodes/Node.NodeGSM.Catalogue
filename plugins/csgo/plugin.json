{
  "$schema": "../plugin.schema.json",
  "id": "csgo",
  "name": "Counter-Strike: Global Offensive Dedicated Server",
  "description": "Dedicated server support for Counter-Strike: Global Offensive. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "platforms": ["windows", "linux"],
  "url": "https://steamdb.info/app/740/info/",
  "tags": ["source", "steamcmd"],
  "docs": [
    { "title": "CS:GO dedicated servers", "url": "https://developer.valvesoftware.com/wiki/Counter-Strike:_Global_Offensive_Dedicated_Servers", "type": "official", "description": "Valve Developer Community" },
    { "title": "Source Dedicated Server", "url": "https://developer.valvesoftware.com/wiki/Source_Dedicated_Server", "type": "official", "description": "Valve Developer Community" },
    { "title": "Command line options", "url": "https://developer.valvesoftware.com/wiki/Command_Line_Options", "type": "official", "description": "Valve Developer Community" },
    { "title": "Game Server Login Tokens (GSLT)", "url": "https://steamcommunity.com/dev/managegameservers", "type": "official", "description": "Create the token your server needs to be listed" },
    { "title": "SteamCMD reference", "url": "https://developer.valvesoftware.com/wiki/SteamCMD", "type": "official", "description": "Valve Developer Community" },
    { "title": "SteamDB: dedicated server app info", "url": "https://steamdb.info/app/740/info/", "type": "unofficial", "description": "App id, depots and build history" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "740"
  },
  "run": {
    "exe": "srcds.exe",
    "stdin": false,
    "linux": { "exe": "srcds_run" },
    "args": [
      "-console",
      ["-game", "csgo"],
      ["-ip", "{ip}"],
      ["-port", "{port}"],
      ["-maxplayers_override", "{maxPlayers}"],
      ["+sv_setsteamaccount", "{gslt}"],
      "{param}",
      ["+map", "{map}"]
    ]
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27015",
    "map": "de_dust2",
    "maxPlayers": "24",
    "additional": "-tickrate 64 -usercon +game_type 0 +game_mode 0 +mapgroup mg_active"
  },
  "query": "a2s",
  "metrics": [
    {
      "id": "fps",
      "name": "Server FPS",
      "unit": "fps",
      "kind": "tick",
      "source": "rcon:stats",
      "pattern": "^\\s*[0-9.]+\\s+[0-9.]+\\s+[0-9.]+\\s+[0-9]+\\s+[0-9]+\\s+([0-9.]+)\\s+[0-9]+",
      "patternFlags": "m",
      "intervalSec": 10,
      "tickTarget": 64,
      "description": "Server frame rate from the 'stats' console command (CPU / NetIn / NetOut / Uptime / Maps / FPS / Players columns). Needs rcon_password in server.cfg."
    }
  ],
  "gslt": true,
  "configs": [
    {
      "id": "server-cfg",
      "name": "server.cfg",
      "path": "csgo/cfg/server.cfg",
      "format": "cfg",
      "description": "Main server config (hostname, rcon_password, ...)"
    }
  ],
  "consoles": [
    { "id": "game", "name": "Game console", "type": "process" },
    { "id": "rcon", "name": "RCON", "type": "rcon", "source": "rcon:{port}:{server-cfg:rcon_password}" },
    { "id": "server-log", "name": "Server log", "type": "log", "source": "server-logs" }
  ],
  "logs": [
    {
      "id": "server-logs",
      "name": "Server logs",
      "path": "csgo/logs/*.log",
      "description": "Written when \"log on\" is set in server.cfg"
    }
  ],
  "backup": {
    "presets": [
      {
        "id": "configs",
        "name": "Server configs",
        "paths": [
          "csgo/cfg"
        ]
      },
      {
        "id": "addons",
        "name": "Addons (SourceMod / Metamod)",
        "paths": [
          "csgo/addons"
        ]
      },
      {
        "id": "custom",
        "name": "Custom content",
        "paths": [
          "csgo/custom",
          "csgo/maps"
        ]
      }
    ],
    "exclude": [
      "csgo/logs",
      "*.log",
      "*.tmp"
    ]
  }
}
