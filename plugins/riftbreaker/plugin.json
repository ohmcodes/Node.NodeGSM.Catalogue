{
  "$schema": "../plugin.schema.json",
  "id": "riftbreaker",
  "name": "Riftbreaker Dedicated Server",
  "description": "WindowsGSM plugin for supporting Riftbreaker Dedicated Server",
  "author": "raziel7893",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/Raziel7893/WindowsGSM.Riftbreaker",
  "tags": [
    "windowsgsm-import",
    "steamcmd"
  ],
  "color": "#34ffeb",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (Raziel7893/WindowsGSM.Riftbreaker)",
      "url": "https://github.com/Raziel7893/WindowsGSM.Riftbreaker",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/4114030/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "4114030"
  },
  "run": {
    "exe": "bin/DedicatedServer.exe",
    "args": [
      "{param}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "16",
    "additional": "cli=1 set campaign open/open set mission campaigns/open/headquarters:magma set difficulty brutal",
    "portIncrement": 1
  },
  "query": "a2s"
}
