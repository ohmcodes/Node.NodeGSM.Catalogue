{
  "$schema": "../plugin.schema.json",
  "id": "ce",
  "name": "Conan Exiles Dedicated Server",
  "description": "Dedicated server support for Conan Exiles. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/443030/info/",
  "tags": ["unreal", "steamcmd"],
  "docs": [
    { "title": "SteamCMD reference", "url": "https://developer.valvesoftware.com/wiki/SteamCMD", "type": "official", "description": "Valve Developer Community" },
    { "title": "SteamDB: dedicated server app info", "url": "https://steamdb.info/app/443030/info/", "type": "unofficial", "description": "App id, depots and build history" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "443030"
  },
  "run": {
    "exe": "ConanSandbox/Binaries/Win64/ConanSandboxServer-Win64-Shipping.exe",
    "args": ["-MultiHome={ip}", "-Port={port}", "-QueryPort={queryPort}", "-MaxPlayers={maxPlayers}", "{param}", "-log"]
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "map": "game.db",
    "maxPlayers": "40",
    "additional": ""
  },
  "query": "a2s",
  "configs": [
    {
      "id": "serversettings-ini",
      "name": "ServerSettings.ini",
      "path": "ConanSandbox/Saved/Config/WindowsServer/ServerSettings.ini",
      "format": "ini",
      "description": "Server name, passwords, gameplay"
    },
    {
      "id": "engine-ini",
      "name": "Engine.ini",
      "path": "ConanSandbox/Saved/Config/WindowsServer/Engine.ini",
      "format": "ini",
      "description": "Engine overrides (server name, mods)"
    },
    {
      "id": "game-ini",
      "name": "Game.ini",
      "path": "ConanSandbox/Saved/Config/WindowsServer/Game.ini",
      "format": "ini"
    }
  ],
  "logs": [
    {
      "id": "conansandbox",
      "name": "ConanSandbox.log",
      "path": "ConanSandbox/Saved/Logs/ConanSandbox.log"
    }
  ]
}
