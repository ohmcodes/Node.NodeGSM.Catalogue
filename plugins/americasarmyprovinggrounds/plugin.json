{
  "$schema": "../plugin.schema.json",
  "id": "americasarmyprovinggrounds",
  "name": "Americas Army Proving Grounds Dedicated Server",
  "description": "WindowsGSM plugin for supporting Americas Army Proving Grounds Dedicated Server",
  "author": "ohmcodes",
  "version": "1.0.0",
  "platforms": [
    "windows"
  ],
  "url": "https://github.com/ohmcodes/WindowsGSM.AmericasArmyProvingGrounds",
  "tags": [
    "windowsgsm-import",
    "steamcmd"
  ],
  "color": "#1e4359",
  "docs": [
    {
      "title": "Original WindowsGSM plugin (ohmcodes/WindowsGSM.AmericasArmyProvingGrounds)",
      "url": "https://github.com/ohmcodes/WindowsGSM.AmericasArmyProvingGrounds",
      "type": "unofficial",
      "description": "Source of the converted metadata"
    },
    {
      "title": "SteamDB: app info",
      "url": "https://steamdb.info/app/203300/info/",
      "type": "unofficial",
      "description": "App id, depots and build history"
    }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "203300"
  },
  "run": {
    "exe": "Binaries/Win32/AALauncher32.exe",
    "args": [
      "{map}?MaxPlayers={maxPlayers}",
      "-multihome={ip}",
      "-Port={port}"
    ],
    "stdin": true
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "maxPlayers": "2"
  },
  "query": "a2s"
}
